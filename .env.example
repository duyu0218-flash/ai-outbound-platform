APP_NAME=AI-Outbound-Platform
ENV=dev

SECRET_KEY=replace-me
JWT_SECRET=replace-with-a-different-long-random-secret
API_KEY=dev-api-key
UI_API_KEY=
# 多租户服务端 Key，每个 Key 只能访问绑定租户。生产环境建议用此项替代全局 API_KEY。
TENANT_API_KEYS_JSON=
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_PASSWORD=replace-db-password
REDIS_PASSWORD=replace-redis-password
# 开发环境使用这些可读标签；生产环境必须在独立env文件中改为 repository@sha256:<64位摘要>。
PYTHON_BASE_IMAGE=python:3.11-slim
NODE_BASE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
DATABASE_URL=postgresql+psycopg://ai_user:replace-db-password@db:5432/ai_outbound
REDIS_URL=redis://:replace-redis-password@redis:6379/0
TELEPHONY_PROVIDER=mock
# 生产多租户线路模式使用 tenant；每个租户需在管理端配置启用的 HTTP 语音桥接线路。
TELEPHONY_WEBHOOK_BASE=http://control-api:8000
TELEPHONY_PROVIDER_ENDPOINT=http://voice-gateway:8002
TELEPHONY_WEBHOOK_TOKEN=
# 控制服务调用语音网关的内部 Bearer Token，生产环境必须使用强随机值。
TELEPHONY_SERVICE_TOKEN=
# 内置语音网关；生产切换为 pbx_http，或使用 freeswitch_esl 直接连接 FreeSWITCH。
VOICE_GATEWAY_DRIVER=mock
PBX_BASE_URL=
PBX_BEARER_TOKEN=
# 直接使用 FreeSWITCH ESL 时设为 freeswitch_esl；不要暴露 8021 到公网。
# WebRTC/生产部署必须填写经过审计的不可变镜像摘要和容器内 `fs_cli -x version` 返回的精确版本。
FREESWITCH_IMAGE=
FREESWITCH_VERSION=
# 启用非核心 media-bug/WebSocket 模块时记录该模块的精确版本；未启用可留空。
FREESWITCH_MEDIA_MODULE_VERSION=
FREESWITCH_ESL_HOST=freeswitch
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=replace-esl-password
FREESWITCH_ESL_TIMEOUT_SEC=5
FREESWITCH_ESL_RECONNECT_SEC=2
FREESWITCH_GATEWAY=carrier
FREESWITCH_CALLER_ID=
FREESWITCH_ORIGINATE_TIMEOUT_SEC=45
FREESWITCH_DIALPLAN_CONTEXT=default
FREESWITCH_AGENT_EXTENSION_TEMPLATE=agent_{agent_id}
FREESWITCH_DEFAULT_HANDOFF_EXTENSION=handoff_default
# 二选一：FreeSWITCH 原生 TTS 引擎+音色，或返回 media_uri/url 的 HTTP TTS 服务。
FREESWITCH_TTS_ENGINE=
FREESWITCH_TTS_VOICE=
FREESWITCH_TTS_HTTP_ENDPOINT=
FREESWITCH_TTS_HTTP_TOKEN=
# 可选媒体流模块命令，例如所选 WebSocket media-bug 模块的 start 命令模板。
# 支持 {uuid}、{call_id}、{speech_webhook_url}、{media_webhook_url}、{asr_provider}、{language}。
FREESWITCH_MEDIA_START_COMMAND_TEMPLATE=
# 转人工前停止所选media-bug模块，例如：uuid_audio_stream {uuid} stop
FREESWITCH_MEDIA_STOP_COMMAND_TEMPLATE=
FREESWITCH_RECORDING_DIR=/var/lib/freeswitch/recordings
FREESWITCH_RECORDING_PUBLIC_BASE_URL=
FREESWITCH_RECORDING_STEREO=true
RTP_PORT_START=20000
RTP_PORT_END=30000

# 浏览器坐席 WebRTC。生产开启后，坐席只有完成麦克风授权和SIP注册才能变为“空闲”。
WEBRTC_ENABLED=false
WEBRTC_WSS_URL=wss://voice.example.com:7443
WEBRTC_SIP_DOMAIN=voice.example.com
WEBRTC_EXTENSION_TEMPLATE=agent_{agent_id}
WEBRTC_SIP_CREDENTIAL_TTL_SEC=900
WEBRTC_MEDIA_STATUS_TTL_SEC=90
WEBRTC_EVENT_STREAM_INTERVAL_SEC=1.5
# 可同时配置STUN与TURN，以英文逗号分隔；TURN凭证按coturn REST API动态生成。
TURN_URLS=stun:voice.example.com:3478,turn:voice.example.com:3478?transport=udp,turns:voice.example.com:5349?transport=tcp
TURN_SHARED_SECRET=replace-with-a-strong-turn-shared-secret
TURN_CREDENTIAL_TTL_SEC=3600
# WebRTC生产部署必须改为不可变镜像摘要；这里的标签只用于开发基线。
COTURN_IMAGE=coturn/coturn:4.17.2-r0
NGINX_IMAGE=nginx:1.28.0-alpine
# FreeSWITCH mod_xml_curl访问动态坐席目录使用，仅在服务器内网传输。
FREESWITCH_DIRECTORY_TOKEN=replace-with-a-strong-directory-token
# FreeSWITCH WSS需要证书链与私钥合并后的PEM文件。
FREESWITCH_WSS_PEM=/etc/letsencrypt/live/voice.example.com/wss.pem
# 线路页填写 credential_ref=PRIMARY_PBX 时，在密钥系统注入 TELEPHONY_SECRET_PRIMARY_PBX。
# TELEPHONY_SECRET_PRIMARY_PBX=
AI_AGENT_URL=http://ai-agent:8001
# 控制服务调用 AI Agent 的内部 Bearer Token，生产环境必须使用强随机值。
AI_AGENT_SERVICE_TOKEN=

SIP_PROVIDER_ENDPOINT=http://freeswitch:8080

# SMS
SMS_PROVIDER=mock
SMS_PROVIDER_ENDPOINT=http://sms-service:8080
SMS_API_KEY=
SMS_CALLBACK_URL=http://control-api:8000/api/v1/webhooks/sms/status
SMS_WEBHOOK_TOKEN=

# For AI
LLM_PROVIDER=rule
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# 当前未采用Pipecat；未来启用时只允许填写精确版本，例如 1.8.1。
PIPECAT_VERSION=
OPENAI_TIMEOUT_SEC=8
CONVERSATION_HISTORY_TURNS=12
CONVERSATION_HISTORY_MAX_CHARS=12000

# 业务回调页填写 webhook_secret_ref=PRIMARY_CALLBACK 时使用。
# BUSINESS_WEBHOOK_SECRET_PRIMARY_CALLBACK=

# Demo 账号体系（管理/座席测试账号）
DEMO_USERS_ENABLED=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=12345678
DEMO_AGENT_USERNAME=1001@test
DEMO_AGENT_PASSWORD=12345678
DEMO_TENANT_ID=1

# 生产化增强配置
REQUEST_TIMEOUT_MS=15000
REQUEST_ID_HEADER=X-Request-ID
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_AUTH_RPM=60
RATE_LIMIT_WINDOW_SEC=60
CONTROL_API_WORKERS=2
# 未在管理端保存“并发容量”时的租户默认值；管理端配置保存后会即时覆盖该租户默认值。
MAX_CONCURRENT_CALLS=20
DEFAULT_CALL_TIMEOUT_SEC=120
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SEC=1
SCHEDULER_BATCH_SIZE=200
AGENT_PRESENCE_TIMEOUT_SEC=90
AI_TURN_LOCK_TTL_SEC=45
AI_TURN_LOCK_WAIT_SEC=15
RECORDING_RETENTION_DAYS=90
PARTIAL_TRANSCRIPT_RETENTION_HOURS=24
RETENTION_SCAN_INTERVAL_SEC=3600
# 录音保留期到期后调用的存储删除适配器；返回 2xx 且 deleted!=false 才会清空数据库地址。
RECORDING_DELETE_ENDPOINT=
RECORDING_DELETE_SERVICE_TOKEN=
RECORDING_DELETE_TIMEOUT_SEC=15
SCHEDULER_LOCK_TTL_SEC=15
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SEC=30
DATABASE_POOL_RECYCLE_SEC=1800
