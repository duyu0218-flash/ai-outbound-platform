APP_NAME=AI-Outbound-Platform
ENV=dev
COMPOSE_CONTAINER_PREFIX=ai-outbound
CONTROL_API_HOST_PORT=8000
RECORDING_ADAPTER_HOST_PORT=8003
SEAWEEDFS_S3_HOST_PORT=8333
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000

SECRET_KEY=replace-me
JWT_SECRET=replace-with-a-different-long-random-secret
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
# Prometheus抓取Control API和Voice Gateway时使用；生产必须替换为至少24位随机值。
METRICS_TOKEN=dev-metrics-token-change-in-production
# 监控Compose使用同一Token文件挂载到应用和Prometheus；运行bootstrap-deployment-secrets.sh生成。
METRICS_TOKEN_FILE=
API_KEY=dev-api-key
UI_API_KEY=
# 多租户服务端 Key，每个 Key 只能访问绑定租户。生产环境建议用此项替代全局 API_KEY。
TENANT_API_KEYS_JSON=
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_PASSWORD=replace-db-password
REDIS_PASSWORD=replace-redis-password
# 开发环境使用这些可读标签；生产环境必须在独立env文件中改为 repository@sha256:<64位摘要>。
PYTHON_BASE_IMAGE=python:3.11-slim
NODE_BASE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.44
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.0
GRAFANA_IMAGE=grafana/grafana:13.2.0
DATABASE_URL=postgresql+psycopg://ai_user:replace-db-password@db:5432/ai_outbound
REDIS_URL=redis://:replace-redis-password@redis:6379/0
TELEPHONY_PROVIDER=mock
# 生产多租户线路模式使用 tenant；每个租户需在管理端配置启用的 HTTP 语音桥接线路。
TELEPHONY_WEBHOOK_BASE=http://control-api:8000
TELEPHONY_PROVIDER_ENDPOINT=http://voice-gateway:8002
TELEPHONY_WEBHOOK_TOKEN=
# 运营商回调 HMAC-SHA256 密钥。签名内容为 `<unix_timestamp>.<raw_body>`。
TELEPHONY_WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_MAX_AGE_SEC=300
# 控制服务调用语音网关的内部 Bearer Token，生产环境必须使用强随机值。
TELEPHONY_SERVICE_TOKEN=
# 内置语音网关；生产切换为 pbx_http，或使用 freeswitch_esl 直接连接 FreeSWITCH。
VOICE_GATEWAY_DRIVER=mock
# 生产默认保持 legacy；Pipecat 候选链路必须经回归和灰度后才能切换。
VOICE_AI_PIPELINE=legacy
PBX_BASE_URL=
PBX_BEARER_TOKEN=
# 直接使用 FreeSWITCH ESL 时设为 freeswitch_esl；不要暴露 8021 到公网。
# WebRTC/生产部署必须填写经过审计的不可变镜像摘要和容器内 `fs_cli -x version` 返回的精确版本。
FREESWITCH_IMAGE=
FREESWITCH_VERSION=
# 启用非核心 media-bug/WebSocket 模块时记录该模块的精确版本；未启用可留空。
FREESWITCH_MEDIA_MODULE_VERSION=
FREESWITCH_ESL_HOST=freeswitch
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=replace-esl-password
FREESWITCH_ESL_TIMEOUT_SEC=5
FREESWITCH_ESL_RECONNECT_SEC=2
FREESWITCH_GATEWAY=carrier
FREESWITCH_CALLER_ID=
FREESWITCH_ORIGINATE_TIMEOUT_SEC=45
FREESWITCH_PLAYBACK_TIMEOUT_SEC=30
FREESWITCH_DIALPLAN_CONTEXT=agent-restricted
FREESWITCH_AGENT_EXTENSION_TEMPLATE=agent_{agent_id}
FREESWITCH_DEFAULT_HANDOFF_EXTENSION=handoff_default
# 二选一：FreeSWITCH 原生 TTS 引擎+音色，或返回 media_uri/url 的 HTTP TTS 服务。
FREESWITCH_TTS_ENGINE=
FREESWITCH_TTS_VOICE=
FREESWITCH_TTS_HTTP_ENDPOINT=
FREESWITCH_TTS_HTTP_TOKEN=
# 可选媒体流模块命令，例如所选 WebSocket media-bug 模块的 start 命令模板。
# 支持 {uuid}、{call_id}、{speech_webhook_url}、{media_webhook_url}、{asr_provider}、{language}。
FREESWITCH_MEDIA_START_COMMAND_TEMPLATE=
# Pipecat 链路的双向媒体命令模板；必须由已验收的 FreeSWITCH WebSocket media-bug 模块提供。
# 支持 {uuid}、{call_id}、{session_id}、{media_ws_url}、{sample_rate}、{channels}、{codec}。
# 模块必须双向传输无头、小端、单声道 PCM16。
FREESWITCH_PIPECAT_START_COMMAND_TEMPLATE=
# 转人工前停止所选media-bug模块，例如：uuid_audio_stream {uuid} stop
FREESWITCH_MEDIA_STOP_COMMAND_TEMPLATE=
FREESWITCH_RECORDING_DIR=/var/lib/freeswitch/recordings
FREESWITCH_RECORDING_PUBLIC_BASE_URL=
FREESWITCH_RECORDING_STEREO=true
RTP_PORT_START=20000
RTP_PORT_END=30000

# 浏览器坐席 WebRTC。生产开启后，坐席只有完成麦克风授权和SIP注册才能变为“空闲”。
WEBRTC_ENABLED=false
WEBRTC_WSS_URL=wss://voice.example.com:7443
WEBRTC_SIP_DOMAIN=voice.example.com
WEBRTC_EXTENSION_TEMPLATE=agent_{agent_id}
WEBRTC_SIP_CREDENTIAL_TTL_SEC=900
WEBRTC_MEDIA_STATUS_TTL_SEC=90
WEBRTC_EVENT_STREAM_INTERVAL_SEC=1.5
# 可同时配置STUN与TURN，以英文逗号分隔；TURN凭证按coturn REST API动态生成。
TURN_URLS=stun:voice.example.com:3478,turn:voice.example.com:3478?transport=udp,turns:voice.example.com:5349?transport=tcp
TURN_SHARED_SECRET=replace-with-a-strong-turn-shared-secret
TURN_CREDENTIAL_TTL_SEC=3600
# WebRTC生产部署必须改为不可变镜像摘要；这里的标签只用于开发基线。
COTURN_IMAGE=coturn/coturn:4.17.2-r0
NGINX_IMAGE=nginx:1.28.0-alpine
# FreeSWITCH mod_xml_curl访问动态坐席目录使用，仅在服务器内网传输。
FREESWITCH_DIRECTORY_TOKEN=replace-with-a-strong-directory-token
# FreeSWITCH WSS需要证书链与私钥合并后的PEM文件。
FREESWITCH_WSS_PEM=/etc/letsencrypt/live/voice.example.com/wss.pem
# 线路页填写 credential_ref=PRIMARY_PBX 时，在密钥系统注入 TELEPHONY_SECRET_PRIMARY_PBX。
# TELEPHONY_SECRET_PRIMARY_PBX=
AI_AGENT_URL=http://ai-agent:8001
# 控制服务调用 AI Agent 的内部 Bearer Token，生产环境必须使用强随机值。
AI_AGENT_SERVICE_TOKEN=

SIP_PROVIDER_ENDPOINT=http://freeswitch:8080

# SMS
SMS_PROVIDER=mock
SMS_PROVIDER_ENDPOINT=http://sms-service:8080
SMS_API_KEY=
SMS_CALLBACK_URL=http://control-api:8000/api/v1/webhooks/sms/status
SMS_WEBHOOK_TOKEN=
SMS_WEBHOOK_SECRET=

# For AI
LLM_PROVIDER=rule
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# 外部模型必须由租户在管理端显式启用；生产还必须限制到已审批域名并默认脱敏。
LLM_ALLOWED_HOSTS=
LLM_SEND_PII=false
LLM_REQUIRE_HTTPS=true
# Pipecat候选实时流水线：代码与矩阵锁定同一精确版本。
PIPECAT_VERSION=1.8.1+outbound.1
PIPECAT_MEDIA_WS_BASE=ws://voice-gateway:8002/v1/pipecat/media
PIPECAT_SAMPLE_RATE=8000
PIPECAT_CHANNELS=1
# raw_pcm preserves generic adapters; voismart enables built-in start/stop,
# interruption buffer clearing and actual FreeSWITCH playout events.
PIPECAT_MEDIA_PROTOCOL=raw_pcm
# Required only when adding docker-compose.media.yml. Use your project's subnet.
MEDIA_ESL_ALLOWED_CIDR=
PIPECAT_SESSION_TIMEOUT_SEC=300
# 从媒体启动命令成功到 WebSocket transport 就绪的上限（秒），超时挂断并释放会话。
PIPECAT_MEDIA_CONNECT_TIMEOUT_SEC=15
# 单个 Voice Gateway 进程的硬并发门禁，不得超过云 ASR 已购并发。
PIPECAT_MAX_ACTIVE_SESSIONS=100
PIPECAT_STT_PROVIDER=openai-realtime
PIPECAT_TTS_PROVIDER=openai
PIPECAT_OPENAI_API_KEY=
PIPECAT_OPENAI_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime
PIPECAT_OPENAI_BASE_URL=
PIPECAT_TTS_MODEL=gpt-4o-mini-tts
PIPECAT_TTS_VOICE=alloy
# 默认禁止静默降级；开启时还必须配置 FREESWITCH_MEDIA_START_COMMAND_TEMPLATE。
PIPECAT_FALLBACK_TO_LEGACY=false
# 阿里云实时 ASR：使用时将 PIPECAT_STT_PROVIDER 改为 aliyun-nls。
# Token 是短时凭证；生产建议由刷新进程原子更新挂载文件，不要写入镜像或仓库。
ALIYUN_NLS_GATEWAY_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1
ALIYUN_NLS_APPKEY=
ALIYUN_NLS_TOKEN=
ALIYUN_NLS_TOKEN_FILE=
ALIYUN_NLS_VOCABULARY_ID=
ALIYUN_NLS_CUSTOMIZATION_ID=
ALIYUN_NLS_MAX_SENTENCE_SILENCE_MS=800
ALIYUN_NLS_ENABLE_PUNCTUATION_PREDICTION=true
ALIYUN_NLS_ENABLE_INVERSE_TEXT_NORMALIZATION=true
ALIYUN_NLS_ENABLE_WORDS=true
ALIYUN_NLS_ENABLE_SEMANTIC_SENTENCE_DETECTION=false
ALIYUN_NLS_ENABLE_IGNORE_SENTENCE_TIMEOUT=true
ALIYUN_NLS_DISFLUENCY=false
ALIYUN_NLS_CONNECT_TIMEOUT_SEC=8
ALIYUN_NLS_STOP_TIMEOUT_SEC=3
OPENAI_TIMEOUT_SEC=8
CONVERSATION_HISTORY_TURNS=12
CONVERSATION_HISTORY_MAX_CHARS=12000

# 业务回调页填写 webhook_secret_ref=PRIMARY_CALLBACK 时使用。
# BUSINESS_WEBHOOK_SECRET_PRIMARY_CALLBACK=

# Demo 账号体系（管理/座席测试账号）
DEMO_USERS_ENABLED=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=12345678
DEMO_AGENT_USERNAME=1001@test
DEMO_AGENT_PASSWORD=12345678
DEMO_TENANT_ID=1

# 生产化增强配置
REQUEST_TIMEOUT_MS=15000
# 大文件导入/导出使用幂等键和尺寸/行数门禁，不使用会产生“504但后台继续提交”的通用超时。
REQUEST_TIMEOUT_EXEMPT_PATHS=/api/v1/contacts/import,/api/v1/contacts/export
REQUEST_ID_HEADER=X-Request-ID
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_AUTH_RPM=60
RATE_LIMIT_WINDOW_SEC=60
CONTROL_API_WORKERS=2
# 未在管理端保存“并发容量”时的租户默认值；管理端配置保存后会即时覆盖该租户默认值。
MAX_CONCURRENT_CALLS=20
# 生产必须填写允许拨打的国家码/号段，例如 86,63；管理端可按租户进一步收窄。
OUTBOUND_ALLOWED_PHONE_PREFIXES=
OUTBOUND_DAILY_CALL_LIMIT=10000
OUTBOUND_PLATFORM_MAX_CONCURRENT=20
# Independent credentials; NEVER reuse service/webhook/ESL/security-admin keys.
# Required for real dialing, even ENV=dev. Empty route map deliberately denies all.
VOICE_COMMAND_SECRET=
VOICE_SECURITY_ADMIN_TOKEN=
OUTBOUND_SECURITY_APPROVAL_TOKEN=
VOICE_SECURITY_DB_PATH=/var/lib/voice-security/ledger.sqlite3
VOICE_SECURITY_ROUTES_JSON={}
VOICE_SECURITY_ROUTES_FILE=
VOICE_CALLBACK_BASE_URL=http://control-api:8000
# Explicit trusted private Compose service, not an arbitrary callback host.
VOICE_CALLBACK_ALLOW_PRIVATE_HTTP=true
VOICE_CALLBACK_FAILURE_STOP_SEC=30
VOICE_MAX_CONCURRENT=20
VOICE_CPS=2
VOICE_DAILY_CALL_LIMIT=1000
# Integer minor currency units; route tariffs must be conservative upper bounds.
VOICE_HOUR_BUDGET_MINOR=10000
VOICE_DAY_BUDGET_MINOR=50000
VOICE_MAX_DURATION_SEC=300
# Production API keys default to read-only. Example scopes: contacts:write,
# campaigns:write, calls:dial, calls:control. Configured per tenant, by ops only.
TENANT_API_SCOPES_JSON={}
DEFAULT_CALL_TIMEOUT_SEC=120
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SEC=1
SCHEDULER_BATCH_SIZE=200
AGENT_PRESENCE_TIMEOUT_SEC=90
AI_TURN_LOCK_TTL_SEC=45
AI_TURN_LOCK_WAIT_SEC=15
RECORDING_RETENTION_DAYS=90
PARTIAL_TRANSCRIPT_RETENTION_HOURS=24
FINAL_TRANSCRIPT_RETENTION_DAYS=90
CALL_SENSITIVE_DATA_RETENTION_DAYS=180
RETENTION_SCAN_INTERVAL_SEC=3600
# SeaweedFS S3兼容录音存储和内部适配器。生产必须替换凭证、限制来源域名并锁定镜像digest。
RECORDING_STORAGE_SERVICE_TOKEN=dev-recording-storage-token-change-in-production
RECORDING_S3_ACCESS_KEY_ID=dev-recordings
RECORDING_S3_SECRET_ACCESS_KEY=dev-recordings-secret-change-in-production
RECORDING_S3_BUCKET=ai-outbound-recordings
RECORDING_S3_KEY_PREFIX=recordings
RECORDING_SOURCE_ALLOWED_HOSTS=voice-gateway,freeswitch,host.docker.internal,localhost,127.0.0.1
RECORDING_SOURCE_REQUIRE_HTTPS=false
RECORDING_MAX_BYTES=536870912
# 录音保留期到期后调用的存储删除适配器；返回 2xx 且 deleted!=false 才会清空数据库地址。
RECORDING_DELETE_ENDPOINT=http://recording-adapter:8003/v1/recordings/delete
RECORDING_DELETE_SERVICE_TOKEN=dev-recording-storage-token-change-in-production
RECORDING_DELETE_TIMEOUT_SEC=15
# 将运营商临时录音复制到平台托管对象存储的内部适配器；响应须返回 storage_uri 和可选 checksum_sha256。
RECORDING_INGEST_ENDPOINT=http://recording-adapter:8003/v1/recordings/ingest
RECORDING_INGEST_SERVICE_TOKEN=dev-recording-storage-token-change-in-production
RECORDING_INGEST_TIMEOUT_SEC=60
# 联系人 CSV 的同步流式处理保护阈值。
CONTACT_IMPORT_MAX_BYTES=20971520
CONTACT_IMPORT_MAX_ROWS=200000
CONTACT_IMPORT_MAX_ERRORS=1000
CONTACT_EXPORT_BATCH_SIZE=1000
CONTACT_IMPORT_BATCH_SIZE=1000
TTS_PLAYBACK_TIMEOUT_SEC=30
SCHEDULER_LOCK_TTL_SEC=15
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SEC=30
DATABASE_POOL_RECYCLE_SEC=1800
# 开发环境可自动建表；生产必须设为 false，并在发布阶段显式运行 schema_bootstrap/migration_runner。
AUTO_MIGRATE=true
