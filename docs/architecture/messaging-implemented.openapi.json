        "responses": {
          "202": {
            "description": "成功；受理不等于送达",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "default": {
            "description": "业务错误；框架层非法参数可能返回已有通用错误结构",
            "content": {
              "application/json": {
