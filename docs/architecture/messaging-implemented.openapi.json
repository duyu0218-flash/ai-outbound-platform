{
  "openapi": "3.0.3",
  "info": {
    "title": "消息开放平台——当前沙箱实现契约",
    "version": "0.1.0",
    "description": "以 MessageApi 控制器为准。全部通道为 mock，无真实发送。跨企业委托、终端探测、自动降级、真实资费与供应商适配未开放。每个下游企业必须建立独立租户；同租户应用共享余额。签名说明见 messaging-implementation.md。"
  },
  "servers": [
    {
      "url": "/openapi/v1"
    }
  ],
  "security": [
    {
      "Hmac": []
    }
  ],
