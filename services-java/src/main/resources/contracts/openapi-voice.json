  "components": {
    "schemas": {
      "CallRequest": {
        "properties": {
          "call_id": {
            "type": "string",
            "title": "Call Id"
          },
          "expected_attempt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Attempt"
          },
          "provider_call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Call Id"
          },
          "expected_speech_event_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Speech Event Id"
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          },
          "target_group": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Group"
          }
        },
        "type": "object",
        "required": [
          "call_id"
        ],
        "title": "CallRequest"
      },
      "DialRequest": {
        "properties": {
          "call_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Call Id"
          },
          "phone": {
            "type": "string",
            "maxLength": 32,
            "minLength": 6,
            "title": "Phone"
          },
          "webhook_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Webhook Url"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "call_id",
          "phone",
          "webhook_url"
        ],
        "title": "DialRequest"
      },
      "SecurityStopRequest": {
        "properties": {
          "stopped": {
            "type": "boolean",
            "title": "Stopped"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
