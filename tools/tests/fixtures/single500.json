    "ai-agent-1": {
      "environment": {
        "JAVA_BIND_ADDRESS": "127.0.0.1",
        "LLM_QUOTA_DB_PATH": "/var/lib/model-quota/account.db",
        "LLM_QUOTA_RPM": "100",
        "LLM_QUOTA_RPS": "10",
        "LLM_QUOTA_SCOPE": "primary-account",
        "LLM_QUOTA_TPM": "10000",
        "PORT": "8025"
      },
      "network_mode": "host",
      "command": [
        "java",
        "-jar",
        "/app/services.jar"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "java",
          "-jar",
          "/app/services.jar",
          "--healthcheck"
        ],
        "timeout": "15s",
        "interval": "10s",
        "retries": 5,
        "start_period": "30s"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "model_quota",
          "target": "/var/lib/model-quota",
          "volume": {}
        }
      ],
      "cpus": 0.5,
      "mem_limit": "1073741824"
    },
