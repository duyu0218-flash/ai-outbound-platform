# Merge with required production application secrets from .env.example.
# Managed primary, not the read replica; bootstrap uses a direct connection.
TELEPHONY_PROVIDER=http
TELEPHONY_PROVIDER_ENDPOINT=http://10.20.0.11:8002
TELEPHONY_WEBHOOK_BASE=https://control.example.invalid
TELEPHONY_SERVICE_TOKEN=REPLACE_WITH_GATEWAY_SERVICE_TOKEN
VOICE_COMMAND_SECRET=REPLACE_WITH_DISTINCT_COMMAND_SECRET
AI_AGENT_SERVICE_TOKEN=REPLACE_WITH_AGENT_SERVICE_TOKEN
RECORDING_INGEST_SERVICE_TOKEN=REPLACE_WITH_RECORDING_TOKEN
RECORDING_DELETE_SERVICE_TOKEN=REPLACE_WITH_RECORDING_TOKEN
# Shared fleet limit, not per-instance. Nominal 60k/min; burst 120k/min.
RATE_LIMIT_WEBHOOK_RPM=180000
RATE_LIMIT_WEBHOOK_CONTROL_RPM=120000
# Per process; each host has 2 API processes and 1 worker: 18 DB connections.
# Four hosts: 72 connections plus bootstrap/operations reserve.
DATABASE_POOL_SIZE=6
DATABASE_MAX_OVERFLOW=0
REQUEST_ADMISSION_TOTAL_INFLIGHT=6
REQUEST_ADMISSION_WEBHOOK_INFLIGHT=4
REQUEST_ADMISSION_DEFAULT_INFLIGHT=2
# Per-process shared waiting budget; wait before acquiring a DB connection.
REQUEST_ADMISSION_MAX_WAITERS=8
REQUEST_ADMISSION_TIMEOUT_SEC=0.05

# Java JDBC credentials; perform schema migration offline with a dedicated migrator.
JAVA_DATABASE_URL=jdbc:postgresql://PRIMARY:5432/ai_outbound?sslmode=verify-full
DATABASE_USER=ai_user
DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JAVA_INITIALIZE_SCHEMA=false
JAVA_RELEASE_ACCEPTED=false
REDIS_URL=rediss://:PASSWORD@REDIS:6379/0
JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/etc/java/redis-truststore.p12
# Include required CORS, trusted hosts, JWT, metrics and other secrets from .env.example.
