# Copy outside git. This file contains paths/image identities, not credentials.
NODE_ID=node-1
NODE_PRIVATE_IP=10.20.0.11
CONTROL_IMAGE=registry.example.invalid/outbound/control@sha256:REPLACE
AGENT_IMAGE=registry.example.invalid/outbound/agent@sha256:REPLACE
VOICE_IMAGE=registry.example.invalid/outbound/voice@sha256:REPLACE
RECORDING_IMAGE=registry.example.invalid/outbound/recording@sha256:REPLACE
FREESWITCH_IMAGE=registry.example.invalid/outbound/freeswitch@sha256:REPLACE
COMPACT_NODES_FILE=/etc/ai-outbound/nodes.json
COMPACT_ROUTES_FILE=/etc/ai-outbound/voice-routes.json
COMPACT_BACKEND_ENV_FILE=/etc/ai-outbound/backend.env
COMPACT_AGENT_ENV_FILE=/etc/ai-outbound/agent.env
COMPACT_VOICE_ENV_FILE=/etc/ai-outbound/voice.env
COMPACT_RECORDING_ENV_FILE=/etc/ai-outbound/recording.env
FREESWITCH_CONFIG_DIR=/etc/ai-outbound/freeswitch
FREESWITCH_RECORDING_DIR=/var/lib/ai-outbound/recordings
