<?xml version="1.0"?>
<document type="freeswitch/xml">
  <section name="configuration" description="Local media validation only">
    <configuration name="switch.conf" description="Core">
      <settings>
        <param name="max-sessions" value="20"/>
        <param name="sessions-per-second" value="5"/>
        <param name="rtp-start-port" value="20000"/>
        <param name="rtp-end-port" value="20100"/>
      </settings>
    </configuration>
    <configuration name="modules.conf" description="Minimal media runtime">
      <modules>
        <load module="mod_console"/>
        <load module="mod_event_socket"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_sndfile"/>
        <load module="mod_tone_stream"/>
        <load module="mod_loopback"/>
        <load module="mod_sofia"/>
        <load module="mod_openai_audio_stream"/>
      </modules>
    </configuration>
    <configuration name="post_load_modules.conf" description="No late modules"><modules/></configuration>
    <configuration name="acl.conf" description="Local project network only">
      <network-lists><list name="media_esl" default="deny">
        <node type="allow" cidr="127.0.0.1/32"/>
        <node type="allow" cidr="__MEDIA_CIDR__"/>
      </list></network-lists>
    </configuration>
    <configuration name="console.conf" description="Console">
      <mappings><map name="all" value="warning,err,crit,alert"/></mappings>
      <settings><param name="loglevel" value="warning"/></settings>
    </configuration>
    <configuration name="event_socket.conf" description="Private ESL only">
      <settings>
        <param name="listen-ip" value="0.0.0.0"/>
        <param name="listen-port" value="8021"/>
        <param name="password" value="__ESL_PASSWORD__"/>
        <param name="apply-inbound-acl" value="media_esl"/>
      </settings>
    </configuration>
    <configuration name="sofia.conf" description="No carrier or public SIP listeners">
      <global_settings><param name="log-level" value="0"/></global_settings>
      <profiles/>
    </configuration>
  </section>
  <section name="dialplan" description="Loopback validation, no external destinations">
    <context name="media-test">
      <extension name="handoff-probe">
        <condition field="destination_number" expression="^handoff-probe$">
          <action application="park"/>
        </condition>
      </extension>
      <extension name="tone">
        <condition field="destination_number" expression="^tone$">
          <action application="answer"/>
          <action application="playback" data="tone_stream://%(10000,0,600);loops=-1"/>
        </condition>
      </extension>
    </context>
  </section>
  <section name="directory" description="No real accounts"/>
</document>
