# Copy these non-secret fields into the protected production environment file.
# Every image value must be replaced with the digest observed in the approved registry.
PYTHON_BASE_IMAGE=python@sha256:REPLACE_WITH_64_HEX_DIGEST
NODE_BASE_IMAGE=node@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_64_HEX_DIGEST
REDIS_IMAGE=redis@sha256:REPLACE_WITH_64_HEX_DIGEST
COTURN_IMAGE=coturn/coturn@sha256:REPLACE_WITH_64_HEX_DIGEST
NGINX_IMAGE=nginx@sha256:REPLACE_WITH_64_HEX_DIGEST
FREESWITCH_IMAGE=REPLACE_REGISTRY/REPLACE_IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST

# Capture with: docker exec ai-outbound-freeswitch fs_cli -x version
FREESWITCH_VERSION=REPLACE_WITH_EXACT_VERSION

# Required when FREESWITCH_MEDIA_START_COMMAND_TEMPLATE enables a non-core module.
FREESWITCH_MEDIA_MODULE_VERSION=

# Leave empty while Pipecat is not deployed. If enabled, use an exact x.y.z version.
PIPECAT_VERSION=
