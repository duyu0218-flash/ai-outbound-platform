bind 127.0.0.1
protected-mode yes
port 0
tls-port 6379
tls-cert-file /etc/redis/tls/redis.crt
tls-key-file /etc/redis/tls/redis.key
tls-ca-cert-file /etc/redis/tls/ca.crt
tls-auth-clients no
# Certificate SAN must include localhost; clients verify it in addition to password auth.
dir /data
appendonly yes
appendfsync everysec
maxmemory 512mb
maxmemory-policy noeviction
# Password comes from redis.env REDISCLI_AUTH via the container command.
# Never evict distributed locks/admission keys to hide pressure.
