# Copy outside Git, use chmod 600, fill approved image digests and credentials.
# 32 dedicated vCPU / 64 GiB is a test candidate, not a capacity guarantee.
NODE_ID=single-500
NODE_PRIVATE_IP=127.0.0.1
MEDIA_RPC_TOKEN=
CONTROL_IMAGE=registry.example.invalid/outbound/control@sha256:REPLACE
AGENT_IMAGE=registry.example.invalid/outbound/agent@sha256:REPLACE
VOICE_IMAGE=registry.example.invalid/outbound/voice@sha256:REPLACE
RECORDING_IMAGE=registry.example.invalid/outbound/recording@sha256:REPLACE
FREESWITCH_IMAGE=registry.example.invalid/outbound/freeswitch@sha256:REPLACE
API_PROXY_IMAGE=registry.example.invalid/outbound/nginx@sha256:REPLACE
POSTGRES_IMAGE=registry.example.invalid/postgres@sha256:REPLACE
REDIS_IMAGE=registry.example.invalid/redis@sha256:REPLACE
COMPACT_NODES_FILE=/etc/ai-outbound/single500/nodes.json
COMPACT_ROUTES_FILE=/etc/ai-outbound/single500/voice-routes.json
COMPACT_BACKEND_ENV_FILE=/etc/ai-outbound/single500/backend.env
COMPACT_AGENT_ENV_FILE=/etc/ai-outbound/single500/agent.env
COMPACT_VOICE_ENV_FILE=/etc/ai-outbound/single500/voice.env
COMPACT_RECORDING_ENV_FILE=/etc/ai-outbound/single500/recording.env
SINGLE500_POSTGRES_ENV_FILE=/etc/ai-outbound/single500/postgres.env
SINGLE500_REDIS_ENV_FILE=/etc/ai-outbound/single500/redis.env
SINGLE500_REDIS_CONFIG_FILE=/etc/ai-outbound/single500/redis.conf
FREESWITCH_CONFIG_DIR=/etc/ai-outbound/single500/freeswitch
FREESWITCH_RECORDING_DIR=/var/lib/ai-outbound/recordings
# Set actual approved account-wide quotas, shared by both Agents.
LLM_APPROVED_RPM=
LLM_APPROVED_TPM=
LLM_APPROVED_RPS=
LLM_MAX_OUTPUT_TOKENS=200
