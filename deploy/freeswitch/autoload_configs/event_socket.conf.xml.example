<configuration name="event_socket.conf" description="AI outbound ESL">
  <settings>
    <!-- Keep 8021 on the private Docker/VPC network; never publish it publicly. -->
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="REPLACE_WITH_STRONG_ESL_PASSWORD"/>
    <param name="apply-inbound-acl" value="lan"/>
  </settings>
</configuration>
