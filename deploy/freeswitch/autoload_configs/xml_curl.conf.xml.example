<configuration name="xml_curl.conf" description="Dynamic agent SIP directory">
  <bindings>
    <binding name="agent-directory">
      <param name="gateway-url" value="__CONTROL_API_URL__/internal/freeswitch/directory?token=__DIRECTORY_TOKEN__" bindings="directory"/>
      <param name="method" value="post"/>
      <param name="timeout" value="3"/>
    </binding>
  </bindings>
</configuration>
