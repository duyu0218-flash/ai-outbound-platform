# Merge these settings into the existing platform configuration; disabled by default.
# See docs/architecture/message-channel-bridge-v1.md before enabling a supplier.
MESSAGING_ENABLED=false
MESSAGING_WORKERS_ENABLED=false
MESSAGING_TRANSPORT_ENABLED=false
MESSAGING_PRODUCTION_ENABLED=false
MESSAGING_WEBHOOKS_ENABLED=false
MESSAGING_MIGRATE_CALL_SMS=false
MESSAGING_RETENTION_ENABLED=true
# Generate and inject a dedicated Base64-encoded random 32-byte key; never use a test key.
MESSAGING_MASTER_KEY=
# Persistent private storage, backed up together with the platform database.
MESSAGING_ASSET_ROOT=/app/data/message-assets
# Operator-approved DNS names or IPv4 addresses, comma separated. No tenant overrides.
MESSAGING_CMPP_ALLOWED_HOSTS=
# ENV belongs to the platform: production permits only verified production channels.
# ENV=internal-test permits loopback fixtures solely in an isolated acceptance environment.
