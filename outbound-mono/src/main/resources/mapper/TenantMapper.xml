<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.duozhi.outbound.mapper.TenantMapper">
  <resultMap id="row" type="com.duozhi.outbound.entity.Tenant">
    <id column="id" property="id" javaType="java.lang.Integer"/>
    <result column="name" property="name" javaType="java.lang.String"/>
    <result column="code" property="code" javaType="java.lang.String"/>
    <result column="enabled" property="enabled" javaType="java.lang.Boolean"/>
    <result column="created_at" property="createdAt" javaType="java.time.LocalDateTime"/>
    <result column="updated_at" property="updatedAt" javaType="java.time.LocalDateTime"/>
  </resultMap>
  <insert id="insert" useGeneratedKeys="true" keyProperty="row.id" keyColumn="id">
    INSERT INTO `tenant`
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="row.id != null">`id`,</if>
      `name`,
      `code`,
      `enabled`,
      `created_at`,
      `updated_at`,
    </trim>
    <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
      <if test="row.id != null">#{row.id,jdbcType=INTEGER},</if>
      #{row.name,jdbcType=LONGVARCHAR},
      #{row.code,jdbcType=VARCHAR},
      #{row.enabled,jdbcType=BOOLEAN},
      #{row.createdAt,jdbcType=TIMESTAMP},
      #{row.updatedAt,jdbcType=TIMESTAMP},
    </trim>
  </insert>
  <insert id="insertExplicitId">
    INSERT INTO `tenant`
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="row.id != null">`id`,</if>
      `name`,
      `code`,
      `enabled`,
      `created_at`,
      `updated_at`,
    </trim>
    <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
      <if test="row.id != null">#{row.id,jdbcType=INTEGER},</if>
      #{row.name,jdbcType=LONGVARCHAR},
      #{row.code,jdbcType=VARCHAR},
      #{row.enabled,jdbcType=BOOLEAN},
      #{row.createdAt,jdbcType=TIMESTAMP},
      #{row.updatedAt,jdbcType=TIMESTAMP},
    </trim>
  </insert>
  <select id="findById" resultMap="row">
    SELECT `id`, `name`, `code`, `enabled`, `created_at`, `updated_at` FROM `tenant` WHERE `id` = #{id,jdbcType=INTEGER}
  </select>
  <update id="updateById">
    UPDATE `tenant` SET
      `name` = #{row.name,jdbcType=LONGVARCHAR},
      `code` = #{row.code,jdbcType=VARCHAR},
      `enabled` = #{row.enabled,jdbcType=BOOLEAN},
      `updated_at` = #{row.updatedAt,jdbcType=TIMESTAMP}
    WHERE `id` = #{row.id,jdbcType=INTEGER}
  </update>
  <delete id="deleteById">
    DELETE FROM `tenant` WHERE `id` = #{id,jdbcType=INTEGER}
  </delete>
  <select id="list" resultMap="row">
    SELECT `id`, `name`, `code`, `enabled`, `created_at`, `updated_at` FROM `tenant`
    ORDER BY `id` LIMIT #{limit,jdbcType=INTEGER} OFFSET #{offset,jdbcType=INTEGER}
  </select>
  <update id="patchFields">
    UPDATE `tenant`
    <set>
      <if test="changes.containsKey('name')">`name` = #{changes.name,jdbcType=VARCHAR},</if>
      <if test="changes.containsKey('code')">`code` = #{changes.code,jdbcType=VARCHAR},</if>
      <if test="changes.containsKey('enabled')">`enabled` = #{changes.enabled,jdbcType=BOOLEAN},</if>
      <if test="changes.containsKey('updated_at')">`updated_at` = #{changes.updated_at,jdbcType=TIMESTAMP},</if>
    </set>
    WHERE `id` = #{id}
  </update>
  <select id="lockForTransaction" resultMap="row">SELECT * FROM tenant WHERE id = #{id} FOR UPDATE</select>
  <select id="allForMaintenance" resultMap="row">SELECT * FROM tenant ORDER BY id</select>
</mapper>
