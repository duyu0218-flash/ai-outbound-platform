    <sql id="contactFilters">
        WHERE tenant_id = #{tenantId}
        <if test="keyword != null and keyword != ''">
            AND (phone LIKE CONCAT('%',#{keyword},'%') OR name LIKE CONCAT('%',#{keyword},'%'))
        </if>
        <if test="dnc != null">
            AND dnc = #{dnc}
        </if>
        <if test="consent != null">
            AND consent_state = #{consent}
        </if>
    </sql>
    <select id="searchContacts" resultMap="row">
        SELECT * FROM contact
        WHERE tenant_id = #{tenantId}
        <if test="keyword != null and keyword != ''">
            AND (phone LIKE CONCAT('%',#{keyword},'%') OR name LIKE CONCAT('%',#{keyword},'%'))
        </if>
        <if test="ids != null">
            AND id IN
            <foreach close=")" collection="ids" item="id" open="(" separator=",">
                #{id}
            </foreach>
        </if>
        <if test="dnc != null">
            AND dnc = #{dnc}
        </if>
        <if test="consent != null">
            AND consent_state = #{consent}
        </if>
        ORDER BY created_at DESC,id DESC LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="exportContacts" resultMap="row">
        SELECT * FROM contact WHERE tenant_id = #{tenantId}
        <if test="keyword != null and keyword != ''">
            AND (phone LIKE CONCAT('%',#{keyword},'%') OR name LIKE CONCAT('%',#{keyword},'%'))
        </if>
        <if test="dnc != null">
            AND dnc = #{dnc}
        </if>
        <if test="consent != null">
            AND consent_state = #{consent}
        </if>
        <if test="last != null">
