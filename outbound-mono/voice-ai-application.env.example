# Six voice AI profiles: account application / integration template, 2026-10-24.
# No credentials are included. Copy values into an untracked .env or secret files.
# Java does not automatically load this file. Import configuration at deployment.
# This template keeps real media disabled until the account/API checks are complete.
# See VOICE-AI-PROVIDERS.md for current compatibility items, especially Volcengine.
VOICE_AI_PROFILES_ENABLED=false

# Alibaba Model Studio, China (Beijing), ordinary pay-as-you-go API Key.
# Both profiles may share a Key when their workspace has all required permissions.
DASHSCOPE_API_KEY=
VOICE_AI_ALI_ASR_MODEL=fun-asr-flash-8k-realtime
VOICE_AI_ALI_LLM_MODEL=qwen-flash
VOICE_AI_ALI_TTS_MODEL=cosyvoice-v3-flash
VOICE_AI_ALI_VOICE=longxiaochun_v3
VOICE_AI_ALI_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
VOICE_AI_ALI_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
VOICE_AI_ALI_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Required: workspace-specific WSS endpoint, without query string.
# wss://REAL_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
VOICE_AI_ALI_REALTIME_URL=
VOICE_AI_ALI_REALTIME_MODEL=qwen3.8-omni-flash-realtime
VOICE_AI_ALI_REALTIME_VOICE=Tina

# Volcengine: independent API Keys for ASR, TTS and O2.0 realtime.
# Each Key must have the corresponding service/resource permission.
VOICE_AI_VOLC_ASR_API_KEY=
VOICE_AI_VOLC_TTS_API_KEY=
VOICE_AI_VOLC_REALTIME_API_KEY=
# Alternative: service-specific legacy AppID + Access Token pairs.
# In each service, its API Key takes precedence over its legacy pair.
# A partially filled independent pair fails; it never borrows shared credentials.
VOICE_AI_VOLC_ASR_APP_ID=
VOICE_AI_VOLC_ASR_ACCESS_KEY=
VOICE_AI_VOLC_TTS_APP_ID=
VOICE_AI_VOLC_TTS_ACCESS_KEY=
VOICE_AI_VOLC_REALTIME_APP_ID=
VOICE_AI_VOLC_REALTIME_ACCESS_KEY=
# Optional shared fallback only when that service has no independent credentials.
# Shared API Key takes precedence over a shared legacy pair.
VOICE_AI_VOLC_API_KEY=
VOICE_AI_VOLC_APP_ID=
VOICE_AI_VOLC_ACCESS_KEY=
# ACCESS_KEY here means speech Access Token, not cloud IAM AccessKey/SecretKey.
VOICE_AI_VOLC_ASR_RESOURCE=volc.seedasr.sauc.duration
VOICE_AI_VOLC_TTS_RESOURCE=seed-tts-2.0
VOICE_AI_VOLC_VOICE=zh_female_vv_uranus_bigtts
VOICE_AI_VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOICE_AI_VOLC_TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# Ark text model API Key is separate from all speech credentials.
VOICE_AI_VOLC_LLM_API_KEY=
# Required: enabled text model ID or actual ep-... inference endpoint ID.
VOICE_AI_VOLC_LLM_MODEL=
VOICE_AI_VOLC_LLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# Confirm O2.0 permission; Seeduplex is a different protocol.
VOICE_AI_VOLC_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
VOICE_AI_VOLC_REALTIME_MODEL=1.2.1.1
VOICE_AI_VOLC_REALTIME_VOICE=zh_female_vv_jupiter_bigtts

# Tencent ASR/TTS: account AppID and authorized CAM SecretId/SecretKey.
VOICE_AI_TENCENT_APP_ID=
VOICE_AI_TENCENT_SECRET_ID=
VOICE_AI_TENCENT_SECRET_KEY=
VOICE_AI_TENCENT_ASR_MODEL=8k_zh
VOICE_AI_TENCENT_VOICE=101001
VOICE_AI_TENCENT_ASR_URL=wss://asr.cloud.tencent.com/asr/v2
VOICE_AI_TENCENT_TTS_URL=wss://tts.cloud.tencent.com/stream_wsv2
# TokenHub ordinary API Key, China mainland (Guangzhou); separate from CAM keys.
# Current official mainland domain; also the default in runtime code.
VOICE_AI_TENCENT_LLM_API_KEY=
VOICE_AI_TENCENT_LLM_MODEL=hy3
VOICE_AI_TENCENT_LLM_URL=https://tokenhub.tencentmaas.com/v1/chat/completions

# Baidu Flex public preview: permission approval plus IAM Bearer API Key.
# Expected credential type: bce-v3/... ; not the legacy application OAuth API Key.
VOICE_AI_BAIDU_API_KEY=
VOICE_AI_BAIDU_REALTIME_URL=wss://aip.baidubce.com/ws/2.0/speech/v1/realtime
VOICE_AI_BAIDU_REALTIME_MODEL=qianfan-realtime-flex-v1
VOICE_AI_BAIDU_REALTIME_VOICE=default

# All credential keys support NAME_FILE as an alternative server-side source.
# FreeSWITCH, media URLs and callback authentication reuse the existing deployment.
# After real API checks, configure real telephony separately; do not dial customers
# simply because the account configuration is complete.

# Platform-only encryption key for tenant credentials saved from the admin UI.
# File content: Base64-encoded 32 random bytes; keep separate from database backups.
# Do not set both direct and file values. Missing key disables UI credential writes.
VOICE_AI_CONFIG_MASTER_KEY_FILE=

# S2S 实际音频逐句审核，必须单独开通内容审核服务；百炼 Key 不能代替 RAM 密钥。
VOICE_AI_SAFETY_ACCESS_KEY_ID=
VOICE_AI_SAFETY_ACCESS_KEY_SECRET=
VOICE_AI_SAFETY_ENDPOINT=https://green-cip.cn-shanghai.aliyuncs.com/
VOICE_AI_SAFETY_REGION=cn-shanghai
VOICE_AI_SAFETY_TIMEOUT_MS=1200
VOICE_AI_SAFETY_MAX_PENDING_MS=6000
VOICE_AI_SAFETY_MAX_CONCURRENT=64
VOICE_AI_SAFETY_POLICY_REVISION=sentence-v1

# 百炼业务试聊：已发布应用实际绑定的插件 ID 或智能体节点 ID。
# 也可在平台“百炼账号与应用配置”中保存；缺失时不会创建付费试聊。
VOICE_AI_BAILIAN_TOOL_TARGET=
