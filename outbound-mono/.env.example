# Single JVM application. Copy to .env, fill credentials, and export values yourself.
# No credentials are included; Java/Maven does not automatically load this file.
# The application uses API + AI + voice + recording + native media in the same process.
# MySQL/Redis/FreeSWITCH/S3 are infrastructure, not extra application processes.

ENV=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
MYSQL_JDBC_URL="jdbc:mysql://127.0.0.1:13306/outbound?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC"
MYSQL_DATABASE=outbound
MYSQL_USER=outbound
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=13306
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:16379
S3_PORT=18333
JWT_SECRET=
DEMO_USERS_ENABLED=false
JAVA_RELEASE_ACCEPTED=false
JAVA_WORKERS_ENABLED=false
JAVA_DISPATCH_ENABLED=false
# Bounded batch scheduling is opt-in; these values are not a 500 CPS acceptance.
JAVA_DIAL_BATCH_SIZE=1
JAVA_DIAL_WORKERS=1
JAVA_CALLBACK_BATCH_SIZE=1
# Independent owners of the existing 64 callback partitions (1..4).
JAVA_CALLBACK_WORKERS=1
# Match receiver partition owners when opting into batched delivery.
VOICE_CALLBACK_PARTITION_GROUPS=1
# Bounded task executor / logical AI owners (1..16); defaults remain four.
JAVA_TASK_WORKERS=4
JAVA_AI_TASK_OWNERS=4
TELEPHONY_PROVIDER=mock
VOICE_GATEWAY_DRIVER=mock
VOICE_AI_PIPELINE=legacy
RECORDING_SPOOL_DIR=./data/recording-spool
FREESWITCH_RECORDING_DIR=./data/source-recordings
AI_AGENT_URL=http://127.0.0.1:8080
TELEPHONY_PROVIDER_ENDPOINT=http://127.0.0.1:8080
SIP_PROVIDER_ENDPOINT=http://127.0.0.1:8080
TELEPHONY_WEBHOOK_BASE=http://127.0.0.1:8080
RECORDING_INGEST_ENDPOINT=http://127.0.0.1:8080/v1/recordings/ingest
RECORDING_DELETE_ENDPOINT=http://127.0.0.1:8080/v1/recordings/delete
VOICE_RECORDING_SOURCE_BASE_URL=http://127.0.0.1:8080
PIPECAT_MEDIA_WS_BASE=ws://127.0.0.1:8080/v1/pipecat/media
LLM_PROVIDER=rule
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_CHAT_MODEL=none
S3_ENDPOINT_URL=http://127.0.0.1:18333
S3_REGION=us-east-1
RECORDING_S3_ACCESS_KEY_ID=
RECORDING_S3_SECRET_ACCESS_KEY=
RECORDING_S3_BUCKET=ai-outbound-recordings
RECORDING_S3_KEY_PREFIX=recordings
RECORDING_SOURCE_ALLOWED_HOSTS=127.0.0.1,localhost
RECORDING_STORAGE_SERVICE_TOKEN=
RECORDING_INGEST_SERVICE_TOKEN=
RECORDING_DELETE_SERVICE_TOKEN=
TELEPHONY_SERVICE_TOKEN=
AI_AGENT_SERVICE_TOKEN=
TELEPHONY_WEBHOOK_TOKEN=
TELEPHONY_WEBHOOK_SECRET=
VOICE_COMMAND_SECRET=
METRICS_TOKEN=
TENANT_API_KEYS_JSON={}
TENANT_API_SCOPES_JSON={}
WEBRTC_ENABLED=false
LLM_QUOTA_SCOPE=primary-account
# Replaces the original configured-path enable switch; false retains the former unconfigured mode.
LLM_QUOTA_ENABLED=true
VOICE_GATEWAY_NODES_JSON=[]
MEDIA_WORKERS_JSON=[]

# Optional separate Flyway credentials (otherwise MYSQL_* are used):
# FLYWAY_JDBC_URL=
# FLYWAY_USER=
# FLYWAY_PASSWORD=

